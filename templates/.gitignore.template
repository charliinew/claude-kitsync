# claude-kitsync — allowlist strict
# Strategy: deny all by default, explicitly allow what should be synced.
# This prevents accidental commit of credentials or runtime data.
*
!*/

# Config shareable
!settings.json
!settings.json.enc
!CLAUDE.md

# Répertoires synchronisés
!agents/
!agents/**
!skills/
!skills/**
!hooks/
!hooks/**
!scripts/
!scripts/**
!rules/
!rules/**
!commands/
!commands/**
!output-styles/
!output-styles/**
!workflows/
!workflows/**
!themes/
!themes/**
!keybindings.json

# Méta
!.gitignore
!.kitsync/
!.kitsync/**
!settings.template.json

# Machine-local kitsync state — never synced
.kitsync/encryption.key*
.kitsync/pending-notice
.kitsync/conflict_pending
.kitsync/sync-warning
.kitsync/*.tmp.*

# JAMAIS syncé (explicite) — these override the !*/ rule above
.credentials.json
# skills from your claude.ai account — Claude Code downloads them on startup
skills/synced/
projects/
backups/
cache/
plugins/
file-history/
paste-cache/
shell-snapshots/
session-env/
sessions/
tasks/
telemetry/
stats-cache.json
history.jsonl
settings.local.json
*.local.json
.DS_Store
