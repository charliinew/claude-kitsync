#compdef claude-kitsync

# Profile names known on this machine (.kitsync/local; older setups: .kitsync/config)
_claude_kitsync_profiles() {
  local d="${CLAUDE_HOME:-$HOME/.claude}/.kitsync"
  local -a names
  names=(${(f)"$(grep -h '^KITSYNC_PROFILES_[A-Z0-9_]*_URL=' "$d/local" "$d/config" 2>/dev/null \
    | sed 's/^KITSYNC_PROFILES_//; s/_URL=.*//' | tr '[:upper:]' '[:lower:]' | sort -u)"})
  _describe 'profile' names
}

# Backups `restore` can put back
_claude_kitsync_backups() {
  local -a backups
  backups=(${CLAUDE_HOME:-$HOME/.claude}/.kitsync/backups/{,.}*.bak(N:t))
  _describe 'backup' backups
}

_claude_kitsync() {
  local line state

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-v --version)'{-v,--version}'[Show version]' \
    '1: :->cmds' \
    '*::arg:->args'

  case "$state" in
    cmds)
      _values 'command' \
        'init[Set up ~/.claude as a synced git repo]' \
        'push[Commit and push config changes now]' \
        'pull[Pull config from the remote, resolving conflicts file by file]' \
        'status[What the next push sends, what is incoming]' \
        'log[Sync history, with files and machine names]' \
        'diff[Changes both ways, before syncing]' \
        'publish[Publish agents/skills as a kit on GitHub]' \
        'install[Merge a kit into ~/.claude]' \
        'profile[Separate configs in separate repos (work, perso…)]' \
        'encrypt[Encrypt settings.json before push]' \
        'settings[Change sync preferences]' \
        'doctor[Check that sync works]' \
        'restore[Put back a file kitsync backed up]' \
        'upgrade[Update claude-kitsync to the latest signed release]' \
        'setup-kit[Wire the starter kit hooks and status line into settings.json]' \
        'uninstall[Remove claude-kitsync (keeps ~/.claude)]'
      ;;
    args)
      case $line[1] in
        init)
          _arguments \
            '--remote[Git remote URL]:url:'
          ;;
        push)
          _arguments \
            '(-m)-m[Commit message]:message:' \
            '(-n --dry-run)'{-n,--dry-run}'[Show what would be committed, change nothing]' \
            '--allow-secret[Push this file even if it looks like it holds a secret]:file:_files'
          ;;
        pull)
          _arguments \
            '--force[Take the remote for every conflicting file (local versions backed up)]'
          ;;
        log)
          _arguments \
            '-n[Number of syncs to show]:count:'
          ;;
        install)
          _arguments \
            '--skill[Install skills only]' \
            ':kit url:_urls'
          ;;
        profile)
          _arguments \
            '1:subcommand:(list add switch remove)' \
            '2:profile:_claude_kitsync_profiles'
          ;;
        encrypt)
          _arguments \
            '1:subcommand:(enable disable rotate status)'
          ;;
        restore)
          _arguments \
            '1:backup:_claude_kitsync_backups'
          ;;
        upgrade)
          _arguments \
            '--dev[Upgrade to the latest commit on main]' \
            '--force[Discard local changes in the install directory]' \
            '--no-verify[Skip the release signature check]'
          ;;
        setup-kit)
          _arguments \
            '--print[Show the settings.json snippet instead of editing it]'
          ;;
        uninstall)
          _arguments \
            '(-y --yes)'{-y,--yes}'[Do not ask for confirmation]'
          ;;
      esac
      ;;
  esac
}

_claude_kitsync "$@"
